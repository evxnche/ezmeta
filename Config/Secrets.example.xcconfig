// Copy to Secrets.xcconfig (not committed) and fill in. Host names only, no https:// (xcconfig reads // as a comment).
// BUNDLE_ID: your app's bundle ID; the same one goes in your Wearables Developer Center project.
BUNDLE_ID = com.yourname.deskpal
// TEAM_ID: your Apple development team ID, 10 characters (HANDOVER.md step 4 shows how to find it).
TEAM_ID = 
// VOICE_HOST: your desk-voice deployment, e.g. desk-voice-yourname.vercel.app.
VOICE_HOST = 
// VOICE_KEY: desk-voice's VOICE_KEY env var (same as ~/.claude/deskpal/key).
VOICE_KEY = 
// READER_HOST: your reader-inbox deployment, e.g. reader-inbox-yourname.vercel.app.
READER_HOST = 
// READER_KEY: reader-inbox's READER_KEY env var.
READER_KEY = 
// MAC_HOST: your Mac's local name for Head Spaces (optional): `scutil --get LocalHostName` + .local.
MAC_HOST = 
